<Paragraph Type='Action'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Character'><Text>with others.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Enter others At Athens Emerald Club</Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Now, fair Hippolyta, </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>our nuptial hour</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Draws on apace.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text> Four happy days bring in</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Another moon. </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>But, O, methinks how slow</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>This old moon wanes! </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>She lingers my desires</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Like to a stepdame</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text> or a dowager</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Long withering out</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text> a young man's revenue.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>Four days will quickly </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>steep themselves in night;</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>Four nights will quickly</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text> dream away the time;</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>And then the moon,</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text> like to a silver bow</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>New -bent in heaven, </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>shall behold the night</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>HIPPOLYTA</Text></Paragraph>
<Paragraph Type='Character'><Text>Of our solemnities.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Go, Philostrate,</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Stir up the Athenian </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>youth to merriments.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Awake the pert and </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>nimble spirit of mirth.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUSTurn melancholy </Text></Paragraph>
<Paragraph Type='Character'><Text></Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUSforth to funerals;</Text></Paragraph>
<Paragraph Type='Character'><Text></Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUSThe pale companion</Text></Paragraph>
<Paragraph Type='Character'><Text></Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS is not for our pomp.</Text></Paragraph>
<Paragraph Type='Character'><Text></Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Character'><Text>Philostrate exits.</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>Hippolyta, I wooed thee </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>with my sword</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>And won thy love</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text> doing thee injuries,</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>But I will wed thee </Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>THESEUS</Text></Paragraph>
<Paragraph Type='Character'><Text>in another key,</Text></Paragraph>
