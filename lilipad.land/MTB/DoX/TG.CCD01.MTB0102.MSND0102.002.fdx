<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Enter Titania,  </Text></Paragraph>
<Paragraph Type='Action'><Text>Enter Titania, Queen of Fairies, with her train.</Text></Paragraph>
<Paragraph Type='Character'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Queen of Fairies,</Text></Paragraph>
<Paragraph Type='Action'><Text>Enter Titania, Queen of Fairies, with her train.</Text></Paragraph>
<Paragraph Type='Character'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>with her train.</Text></Paragraph>
<Paragraph Type='Action'><Text>Enter Titania, Queen of Fairies, with her train.</Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Come, now a roundel </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>and a fairy song;</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Then, for the third </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>part of a minute, hence-</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Some to kill cankers </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>in the muskrose buds,</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Some war with reremice </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>for their leathern wings</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>To make my small elves</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text> coats, and some keep back</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>The clamorous owl that </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>nightly hoots and wonders</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>At our quaint spirits. </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text></Text></Paragraph>
<Paragraph Type='Action'><Text>Sing me now asleep.</Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Then to your offices </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>TITANIA</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>and let me rest.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>She lies down.</Text></Paragraph>
<Paragraph Type='Action'><Text>She lies down.</Text></Paragraph>
<Paragraph Type='Character'><Text>NARRATOR</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Fairies sing.</Text></Paragraph>
<Paragraph Type='Action'><Text>Fairies sing.</Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>You spotted snakes </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>with double tongue,</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Thorny hedgehogs, </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>be not seen.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Newts and blindworms,</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text> do no wrong,</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Come not near </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>FIRST FAIRY</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>our Fairy Queen.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Philomel, </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>with melody</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Sing in our </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>sweet lullaby.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Lulla, lulla, lullaby,</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text> lulla, lulla, lullaby.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Never harm</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Nor spell </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>nor charm</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Come our lovely </Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>lady nigh.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>So good night,</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>CHORUS</Text></Paragraph>
<Paragraph Type='Dialogue'><Text> with lullaby.</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>Maya</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Found Yah</Text></Paragraph>
<Paragraph Type='Action'><Text></Text></Paragraph>
<Paragraph Type='Character'><Text>Buju</Text></Paragraph>
<Paragraph Type='Dialogue'><Text>Hello</Text></Paragraph>
